# Notification configuration

# Global settings

layer=overlay
default-timeout=12000
on-notify=exec paplay /usr/share/sounds/freedesktop/stereo/message-new-instant.oga

# Visual

font=Hasklug Nerd Font Propo 11
background-color=#1C1C20
text-color=#E5E2E8
border-color=#A78BC4
border-size=2
padding=10
margin=20
#border-radius=5
width=400
height=300

# Media/Icons

max-icon-size=64
icon-location=left
icon-path=/usr/share/icons/hicolor

# Interaction

on-button-left=invoke-default-action
on-button-right=dismiss

# Critical Notifications

[urgency=high]
border-color=#D69B96
ignore-timeout=1
