# Notification configuration

# Global settings

layer=overlay
default-timeout=7000
on-notify=exec paplay /usr/share/sounds/freedesktop/stereo/message-new-instant.oga

# Visual

font=Hasklug Nerd Font Propo 11
background-color=#000000CC
text-color=#FFFFFF
border-color=#FFFFFF
border-size=1
padding=10
margin=20
#border-radius=5
width=400
height=100

# Media/Icons

max-icon-size=64
icon-location=left
icon-path=/usr/share/icons/hicolor

# Interaction

on-button-left=invoke-default-action
on-button-right=dismiss

# Critical Notifications

[urgency=high]
border-color=#FF5555
ignore-timeout=1
